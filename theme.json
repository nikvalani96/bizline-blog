					"unit": "rem"
				}
			},
			"spacingSizes": [
				{
					"name": "Step 1 - Fixed",
					"size": "0.25rem",
					"slug": "step-1"
				},
				{
					"name": "Step 2 - Fixed",
					"size": "0.5rem",
					"slug": "step-2"
				},
				{
					"name": "2X-Small",
					"size": "0.44rem",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "0.67rem",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "1rem",
					"slug": "40"
